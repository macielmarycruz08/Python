import random

# a list of all possible words that can be the answer
word_bank = ["cat", "dog", "turtle", "fish"]

# randomly choose one of the words to be the answer
word = random.choice(word_bank)

# placeholder for the length of the word
guessedWord = ['_'] * len(word)

# number of attempts
attempts = 10

# loop until attempts run out or word guessed
while attempts > 0:
    print('\nCurrent word: ' + ' '.join(guessedWord))
    guess = input('Guess a letter: ').lower()

    if guess in word:
        for i in range(len(word)):
            if word[i] == guess:
                guessedWord[i] = guess
        print('Great guess!')
    else:
        attempts -= 1
        print('Wrong guess! Attempts left: ' + str(attempts))

    if '_' not in guessedWord:
        print('\nCongratulations!! You guessed the word: ' + word)
        break

    if attempts == 0 and '_' in guessedWord:
        print('\nYou\'ve run out of attempts! The word was: ' + word)
