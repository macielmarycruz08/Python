import random

#1. this will generate a random num
random_num = random.randint(1, 100)

print("Welcome to guess the number!")
print("I'm thinking of a number try to guess it!")

while True:
    guess = int(input("Your guess: "))

    if guess == random_num:
        print("Correct!")
        break
    else:
        print("Nope, Try again!")
        #this checks if guess is smaller than the randomnum 
        #random is the bigger num
        if guess < random_num: 
            print("too low")
        #guess is bigger number
        elif guess > random_num:
            print("too high")
